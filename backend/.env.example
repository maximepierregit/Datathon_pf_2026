# Région Bedrock
AWS_REGION=us-east-1

# Modèles (profils d'inférence). Vérifier l'accès dans la console Bedrock.
MODEL_STRONG=global.anthropic.claude-sonnet-5-5   # PM, CRO
MODEL_FAST=global.anthropic.claude-haiku-5-5      # Extraction, Profil, Juge

# Réflexion du modèle (streamée vers le frontend)
ENABLE_THINKING=true

# Dataset fixe (Parquet). Chemin local ou s3://bucket/cle.parquet
DATASET_PATH=data/universe.parquet

# Pipeline
MAX_PM_RETRIES=1
MAX_ASSETS_PER_PORTFOLIO=40
RISK_FREE_RATE=0.025
# Poids de l'hypothèse de classe dans le rendement espéré (0 = historique pur, 1 = hypothèse pure)
MU_SHRINK=0.5
