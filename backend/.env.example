# Région Bedrock
AWS_REGION=us-east-1

# Modèles (profils d'inférence). Vérifier l'accès dans la console Bedrock.
MODEL_STRONG=global.anthropic.claude-sonnet-5-5   # PM, CRO
MODEL_FAST=global.anthropic.claude-haiku-5-5      # Extraction, Profil, Juge

# Réflexion du modèle (streamée vers le frontend)
ENABLE_THINKING=true

# Dataset fixe (Parquet). Chemin local ou s3://bucket/cle.parquet
# Source de référence (exige s3:GetObject, politique IAM MonPortDatasetRead):
#   MONPORT_UNIVERSE_PARQUET_URI=s3://monport-datasets-381491955506/universe/universe.parquet
# Repli local, sans accès AWS (générer le fichier avec data-prep/build_universe.py):
MONPORT_UNIVERSE_PARQUET_URI=data/universe.parquet
# Table macro US/CA (outils macro des gestionnaires, agents Risque et juge). Défaut: data/macro_long_z.parquet
#   MONPORT_MACRO_PARQUET_URI=s3://monport-datasets-381491955506/macro/macro_long_z.parquet
# Scores de facteurs des actions. Défaut: data/factor_scores.parquet
#   MONPORT_FACTORS_PARQUET_URI=s3://monport-datasets-381491955506/factors/factor_scores.parquet

# Pipeline
MAX_PM_RETRIES=1
MAX_ASSETS_PER_PORTFOLIO=40
