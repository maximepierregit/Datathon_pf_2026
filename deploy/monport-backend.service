# Backend MonPort (agents Strands) sur l'EC2 du front. Installé par deploy-backend.sh.
# Écoute seulement 127.0.0.1:8091 : nginx le publie sous /api/.
[Unit]
Description=MonPort backend
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/opt/monport-backend
Environment=PORT=8091 AWS_REGION=us-east-1
# Dataset réel, lu avec le profil d'instance (WSParticipantRole). Publié par data-prep/build_universe.py --upload.
Environment=DATASET_PATH=s3://monport-datasets-381491955506/universe/universe.parquet
ExecStart=/opt/monport-backend/.venv/bin/python main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
